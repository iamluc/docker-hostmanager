{
    "name": "iamluc/docker-hostmanager",
    "license": "MIT",
    "version": "0.0.4",
    "type": "project",
    "description": "Update /etc/hosts to access running containers",
    "keywords": ["docker", "hosts"],
    "require": {
        "php": "^8.1",
        "symfony/console": "^7.4 || ^8.0",
        "sigwin/docker-php": "^1.0@alpha"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "bin": [
        "bin/docker-hostmanager"
    ],
    "authors": [
        {
            "name": "Luc Vieillescazes",
            "email": "luc@vieillescazes.net"
        }
    ],
    "autoload": {
        "psr-4": {"DockerHostManager\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Test\\": "tests"}
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
